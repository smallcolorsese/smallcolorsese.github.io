<!-- navbar -->
<nav class="navbar">
  <div class="navbar-content">
    <!-- logo -->
    <div class="navbar-logo">
      <a href="<%= url_for() %>">
        <% if (theme.logo) { %>
          <img src="<%= theme.logo %>" alt="<%= config.title %>" />
        <% } else { %>
          <%= config.title %>
        <% } %>
      </a>
    </div>
    
    <!-- search (left side) -->
    <div class="navbar-search-wrapper">
      <div class="google-search-box">
        <svg class="search-icon" viewBox="0 0 1024 1024" version="1.1" xmlns="http://www.w3.org/2000/svg">
          <path d="M448 768a320 320 0 1 0 0-640 320 320 0 0 0 0 640z m0 64a384 384 0 1 1 0-768 384 384 0 0 1 0 768z" fill="currentColor"/>
          <path d="M728.064 779.776l232.32 232.32-45.248 45.248-232.32-232.32 45.248-45.248z" fill="currentColor"/>
        </svg>
        <input type="text" id="navbar-search-input" class="search-input" placeholder="搜索文章...">
      </div>
    </div>

    <!-- navigation links (right side) -->
    <div class="navbar-link">
      <div class="navbar-btn">
        <div></div>
        <div></div>
        <div></div>
      </div>
      <ul class="navbar-list">
        <% for (var i in theme.menu) { %>
          <li class="navbar-list-item"><a href="<%- url_for(theme.menu[i]) %>"><%= i %></a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>